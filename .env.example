# ─── Food Waste Redistribution Platform ───────────────────────────────────────
# All variables required unless marked OPTIONAL

# HTTP server
PORT=8080

# PostgreSQL
DATABASE_URL=postgres://foodwaste:secret@localhost:5432/foodwaste?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT access token
JWT_SECRET=change-me-access-secret-min-32-chars
JWT_EXPIRE_MIN=15

# JWT refresh token
REFRESH_SECRET=change-me-refresh-secret-min-32-chars
REFRESH_EXPIRE_DAYS=30

# CORS – comma-separated origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ML inference service
MLSERVING_URL=http://localhost:8501
MLSERVING_TOKEN=

# ML model bundle directory (for local inference / offline eval)
MODEL_BUNDLE_DIR=./models

# File uploads
MAX_UPLOAD_MB=10

# Carbon accounting factor
CARBON_FACTOR_KG_CO2E_PER_KG=2.5

# Food safety danger zone  (°C)
DANGER_ZONE_MIN_C=4
DANGER_ZONE_MAX_C=60

# Feature flags  (set to "true" to enable mock)
FEATURE_MOCK_ML=false
FEATURE_MOCK_CV=false
FEATURE_MOCK_ROUTING=false

# Mobile minimum supported version
APP_MIN_VERSION=1.0.0

# Firebase service account key path  (OPTIONAL if running without FCM/Firestore)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
